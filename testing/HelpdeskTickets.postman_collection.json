    },
    {
      "name": "T03 \u2013 Create a valid ticket (expect 201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Projector not working in room 210\",\n  \"description\": \"Projector shows 'No Signal' from the podium PC\",\n  \"priority\": \"high\",\n  \"assignee\": \"Liam\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"ticketId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
